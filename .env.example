# 1. AWS credentials
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_REGION=
export AWS_BUCKET_NAME=

# 2. Terraform backend (before terraform init)
export TF_BACKEND_BUCKET=

# 3. After terraform apply
export EMR_APPLICATION_ID=
export EMR_EXECUTION_ROLE_ARN=
export ATHENA_WORKGROUP=

# Derived — do not edit
# Avoids conflict with AWS_REGION forced by ECS Fargate (Prefect Cloud)
export AWS_REGION_BTC=$AWS_REGION
# Terraform reads TF_VAR_* automatically
export TF_VAR_aws_region=$AWS_REGION
export TF_VAR_bucket_name=$AWS_BUCKET_NAME
export TF_VAR_athena_workgroup=$ATHENA_WORKGROUP
