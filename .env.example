# AWS
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_REGION=
export AWS_BUCKET_NAME=

# AWS_REGION_BTC avoids conflict with AWS_REGION forced by ECS Fargate (Prefect Cloud managed execution)
export AWS_REGION_BTC=$AWS_REGION

# Terraform
export TF_VAR_aws_region=$AWS_REGION
export TF_VAR_bucket_name=$AWS_BUCKET_NAME
export TF_BACKEND_BUCKET=

# EMR Serverless (terraform output)
export EMR_APPLICATION_ID=
export EMR_EXECUTION_ROLE_ARN=

# Athena (terraform output)
export ATHENA_WORKGROUP=